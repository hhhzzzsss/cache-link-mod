[network]

limits/debugger/max_chars_per_second=256768
limits/debugger/max_queued_messages=4096

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=4
jolt_physics_3d/simulation/sleep_velocity_threshold=0.06
jolt_physics_3d/simulation/sleep_time_threshold=0.4
jolt_physics_3d/limits/max_bodies=30400
3d/default_gravity=18.0
3d/solver/solver_iterations=8

[rendering]

textures/canvas_textures/default_texture_filter=0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=1
environment/ssao/quality=0
environment/ssil/quality=1
environment/ssil/blur_passes=3
scaling_3d/mode=1
environment/glow/upscale_mode=0
limits/global_shader_variables/buffer_size=262140
global_illumination/sdfgi/probe_ray_count=2
global_illumination/sdfgi/frames_to_converge=1
environment/volumetric_fog/volume_size=16
environment/volumetric_fog/volume_depth=32
environment/volumetric_fog/use_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
2d/snap/snap_2d_vertices_to_pixel=true

[shader_globals]

wind_intensity={
"type": "float",
"value": 0.1
}
wind_direction={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
player_position={
"type": "vec3",
"value": Vector3(1, 0, 0)
}

[steam]

multiplayer_peer/max_channels=4
initialization/app_id=0
initialization/initialize_on_startup=false
initialization/embed_callbacks=false

[threading]

worker_pool/max_threads=8
