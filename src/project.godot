; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="lucid blocks"
config/version="3.0.4"
run/main_scene="res://main/main.tscn"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.6", "Double Precision", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/use_filter=false
boot_splash/image="uid://dh4qu5y3takys"
config/icon="uid://b0lv6dtwvtnhk"

[audio]

buses/default_bus_layout="uid://b3u2fiy5q0kgy"

[autoload]

ModLoader="*uid://cmel8y2vvjp0s"
RenderChecker="*uid://ckdan3nealfj0"
Ref="*res://main/autoload/ref.gd"
ItemMap="*res://main/autoload/item_map.gd"
UUID="*res://main/autoload/uuid.gd"
WordBank="*res://main/autoload/words/word_bank.gd"
Steamworks="*res://main/autoload/steamworks.gd"
BlockSoundMap="*res://main/autoload/block_sound_map.gd"
SpatialMath="*res://main/utils/spatial_math.gd"
MouseHandler="*res://main/ui/mouse/mouse_handler.gd"
SettingsManager="*uid://dv7o4c511l0up"
GuardChecker="*uid://1mx8jihsxf8w"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10
gdscript/warnings/unused_signal=0
gdscript/warnings/redundant_await=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=300
window/size/viewport_height=256
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"

[editor_overrides]

text_editor/behavior/indent/type=1

[editor_plugins]

enabled=PackedStringArray("res://addons/onscreenkeyboard/plugin.cfg", "res://addons/so_fluffy/plugin.cfg")

[file_customization]

folder_colors={
"res://_debug_user/": "red",
"res://addons/": "gray",
"res://bin/": "gray",
"res://debug_save_files/": "red",
"res://icons/": "gray",
"res://main/autoload/": "gray",
"res://main/entity/": "pink",
"res://main/entity/behaviors/": "purple",
"res://main/entity/behaviors/bleed/blood/": "purple",
"res://main/entity/sounds/": "purple",
"res://main/fractal/": "blue",
"res://main/items/": "yellow",
"res://main/items/data/blaster/": "orange",
"res://main/items/data/blocks/": "orange",
"res://main/items/data/blocks/limestone.tres": "gray",
"res://main/items/data/compasses/": "orange",
"res://main/items/data/equipment/": "orange",
"res://main/items/data/explosives/": "orange",
"res://main/items/data/food/": "orange",
"res://main/items/data/glider/": "orange",
"res://main/items/data/ingredients/": "orange",
"res://main/items/data/ingredients/icons/": "orange",
"res://main/items/data/ropes/": "orange",
"res://main/items/data/spawners/": "orange",
"res://main/items/data/tools/": "orange",
"res://main/items/data/tools/icons/": "orange",
"res://main/items/data/wands/": "orange",
"res://main/items/dropped_item/": "gray",
"res://main/items/held_item/": "gray",
"res://main/items/icon_generator/": "gray",
"res://main/mini_game/": "purple",
"res://main/music/": "blue",
"res://main/plot/": "green",
"res://main/save_file/": "gray",
"res://main/ui/": "red",
"res://main/utils/": "gray",
"res://main/world/": "teal",
"res://main/world/biomes/": "yellow",
"res://main/world/decorations/": "yellow",
"res://main/world/dungeon_textures/": "yellow",
"res://main/world/generators/": "yellow",
"res://main/world/living_block/": "purple",
"res://main/world/model_templates/": "gray",
"res://main/world/rendering/": "gray",
"res://main/world/rendering/environments/": "gray",
"res://main/world/structures/": "yellow",
"res://main/world/sun/": "gray",
"res://main/world/weather/": "gray"
}

[global_group]

modulate=""
save=""
preserve=""
preserve_but_delete_on_unload=""
delete_on_quit=""
save_register=""
preserve_on_modified_chunks_only=""

[gui]

common/snap_controls_to_pixels=false

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 3,
"compress/normal_map": 0,
"detect_3d/compress_to": 0,
"editor/convert_colors_with_editor_theme": false,
"editor/scale_with_editor_scale": true,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/fix_alpha_border": false,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": "",
"svg/scale": 1.0
}
scene={
"_subresources": {},
"animation/fps": 30,
"animation/import": true,
"animation/import_rest_as_RESET": false,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"gltf/embedded_image_handling": 0,
"gltf/naming_version": 1,
"import_script/path": "",
"meshes/create_shadow_meshes": true,
"meshes/ensure_tangents": true,
"meshes/force_disable_compression": false,
"meshes/generate_lods": true,
"meshes/light_baking": 1,
"meshes/lightmap_texel_size": 0.2,
"nodes/apply_root_scale": true,
"nodes/import_as_skeleton_bones": false,
"nodes/root_name": "",
"nodes/root_scale": 1.0,
"nodes/root_type": "",
"nodes/use_node_type_suffixes": true,
"skins/use_named_skins": true
}

